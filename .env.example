# Development defaults for Docker Compose.
# Copy to .env before starting: cp .env.example .env

DJANGO_SETTINGS_MODULE=config.settings.development
SECRET_KEY=dev-only-change-me
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1,web
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

POSTGRES_DB=ministry
POSTGRES_USER=ministry
POSTGRES_PASSWORD=ministry
DATABASE_URL=postgresql://ministry:ministry@db:5432/ministry

# Leave blank in development. The console email backend prints messages to the web container log.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=childrens-ministries@newfadama.local

# Production only. Set USE_HTTPS=true when a TLS proxy sits in front of this app.
USE_HTTPS=false
SECURE_SSL_REDIRECT=false
SECURE_HSTS_SECONDS=0
COLLECT_STATIC=0
