# Production settings for compose.prod.yaml.
# On the server: cp .env.production.example .env, then replace every CHANGE_ME.
# Generate secrets with: openssl rand -base64 48 | tr -d '/+=' | cut -c1-50

DJANGO_SETTINGS_MODULE=config.settings.production
SECRET_KEY=CHANGE_ME
ALLOWED_HOSTS=kids.example.org
CSRF_TRUSTED_ORIGINS=https://kids.example.org

# The password appears twice. Keep them identical, and avoid / @ : in it
# so DATABASE_URL needs no escaping.
POSTGRES_DB=ministry
POSTGRES_USER=ministry
POSTGRES_PASSWORD=CHANGE_ME
DATABASE_URL=postgresql://ministry:CHANGE_ME@db:5432/ministry

# Leave the console backend until SMTP is set up. Mail then goes to the web container log.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=childrens-ministries@kids.example.org

# Caddy (or another TLS proxy) on the host forwards to 127.0.0.1:8001.
USE_HTTPS=true
SECURE_SSL_REDIRECT=true
# Start at 0. Raise to 31536000 once HTTPS has worked for a few days.
SECURE_HSTS_SECONDS=0

# Gunicorn workers. 2 suits a 2–4 GB VPS.
WEB_CONCURRENCY=2
